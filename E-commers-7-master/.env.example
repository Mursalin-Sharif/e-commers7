# Required on Vercel (Settings → Environment Variables)
# Values must NOT be empty — empty DATABASE_URL causes 500 errors.

DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/paki?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=use-a-long-random-secret-min-32-chars
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
NEXT_PUBLIC_APP_NAME=Paki

# Optional
SHIPPING_DHAKA_INSIDE=70
SHIPPING_DHAKA_OUTSIDE=130
